# ============================================
# LMS Backend - Environment Variables Template
# Copy this file to .env and fill in your values
# ============================================

# Server Port
PORT=5000

# Node Environment
NODE_ENV=production

# MongoDB Connection String (Atlas Recommended)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT Secret for Session Security (use a long random string)
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRE=7d

# Cloudinary Credentials (for file/image uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Rate Limiting Configuration (Configurable Thresholds)
RATE_LIMIT_AUTH_WINDOW_MINUTES=15
RATE_LIMIT_AUTH_IP_MAX=30
RATE_LIMIT_AUTH_ACCOUNT_MAX_ATTEMPTS=5
RATE_LIMIT_AUTH_IP_MAX_ATTEMPTS=8
RATE_LIMIT_AUTH_BASE_BACKOFF_SECONDS=2
RATE_LIMIT_AUTH_MAX_BACKOFF_SECONDS=900
RATE_LIMIT_PUBLIC_WINDOW_MINUTES=15
RATE_LIMIT_PUBLIC_MAX=200
RATE_LIMIT_USER_WINDOW_MINUTES=15
RATE_LIMIT_USER_MAX=1200
